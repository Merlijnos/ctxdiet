{
  "name": "ctxdiet",
  "version": "0.4.0",
  "description": "Detect, fix, and measure AI coding-agent context-token waste across Claude Code, Codex, Cursor, Gemini, Windsurf, Copilot, Cline, Roo & more. Other tools report waste \u2014 ctxdiet fixes it.",
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "cursor",
    "gemini",
    "copilot",
    "windsurf",
    "agents",
    "agents-md",
    "mcp",
    "tokens",
    "token-optimization",
    "context",
    "context-window",
    "llm",
    "ai-agents",
    "cursorrules",
    "cli",
    "ai",
    "cline",
    "roo-code",
    "aider",
    "zed",
    "junie",
    "agent-rules",
    "context-engineering"
  ],
  "license": "MIT",
  "author": "Merlijn de Groot <merlijndegroot498@gmail.com>",
  "homepage": "https://github.com/Merlijnos/ctxdiet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Merlijnos/ctxdiet.git"
  },
  "bugs": {
    "url": "https://github.com/Merlijnos/ctxdiet/issues"
  },
  "funding": "https://github.com/sponsors/Merlijnos",
  "type": "module",
  "bin": {
    "ctxdiet": "dist/src/index.js",
    "slimclaude": "dist/src/index.js"
  },
  "files": [
    "dist/src",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepare": "tsc",
    "test": "npm run clean && tsc && node --test dist/test/*.test.js",
    "prepublishOnly": "npm test",
    "start": "node dist/src/index.js",
    "coverage": "npm run clean && tsc && node --test --experimental-test-coverage dist/test/*.test.js",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^15.0.0",
    "gpt-tokenizer": "^4.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "typescript": "^7.0.2"
  }
}
